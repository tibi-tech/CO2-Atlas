# Copernicus Data Space Ecosystem OAuth client (https://shapps.dataspace.copernicus.eu/dashboard → User settings → OAuth clients)
# Optional: you can also paste these in the app under ⚙ Settings. Values here take priority.
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# When set, creating regions and starting calculations requires this password (viewing stays public)
DEMO_PASSWORD=

# Optional overrides
# DATA_DIR=./backend/data
# MAX_REGION_KM2=1000
# MAX_MONTHS_PER_JOB=12
# SEED_OEIRAS=true
